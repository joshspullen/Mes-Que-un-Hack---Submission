# Match data: never commit (competition terms). Do not publish derived frame-level data either.
data/*
!data/.gitkeep
*.mp4
*_atd.txt
*_atd.xml
*_homography.csv
*_smart_tagging.xml
cache/
features/
*.parquet
*.feather
*.npy
*.npz
*.pkl

# Full-match ground truth must never appear here (organisers only)
*_possession_gt.csv
*_possession_gt_meta.json
*_possession_gt_reference.csv

# Our outputs: work-in-progress submissions stay local.
# The final file is added on purpose with:  git add -f submissions/<team_name>.csv
submissions/*.csv
evaluation/results/*.csv
evaluation/reports/
evaluation/scoreboard.csv

# Python / env / notebooks / editors
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.env
.DS_Store
.idea/
.vscode/

# run logs
*.log

# local inspection figures (frame-level views of the match data)
inspect/
